		<option name="INV_AUTOSELL_TOSLOT"	value="60" /> 			<!-- 30 = last slot bag 1 --><!-- 30 = 背包 1 的最后一格 -->
		<option name="INV_AUTOSELL_QUALITY"	value="white,green" /> 	<!-- white,green,blue,purple  --><!-- white（白色）,green（绿色）,blue（蓝色）,purple（紫色）  -->

		<!-- Harvest options --><!-- 采集选项 -->
		<option name="HARVEST_DISTANCE"		value="120" />
		<option name="HARVEST_WOOD"			value="true" /> 		<!-- Choose which types to harvest. --><!-- 选择要采集的类型。 -->
		<option name="HARVEST_HERB"			value="true" /> 		<!-- "true" = harvest, "false" = do not harvest --><!-- "true" = 采集, "false" = 不采集 -->
		<option name="HARVEST_ORE"			value="true" />

		<!-- Eggpet options --><!-- 蛋宠选项 -->
		<option name="EGGPET_ENABLE_CRAFT"	value="false" />		<!-- If using same slot for assist and craft, onlt 1 can be enabled. --><!-- 如果辅助和制作使用同一格位，只能启用其中一个。 -->
		<option name="EGGPET_CRAFT_SLOT"	value="1" />
		<option name="EGGPET_ENABLE_ASSIST"	value="false" />
		<option name="EGGPET_ASSIST_SLOT"	value="1" />
		<option name="EGGPET_CRAFT_RATIO"	value="1:1:1" /> 		<!-- mining:woodworking:herbalism ratio to produce. --><!-- 采矿:木工:草药学的制作比例。 -->
		<option name="EGGPET_CRAFT_INDEXES"	value="" /> 	 		<!-- override auto craft index for mining,woodworking,herbalism eg. "2,,"--><!-- 覆盖采矿、木工、草药学的自动制作索引，例如 "2,," -->


		<!-- Log out and resurrect settings --><!-- 登出和复活设置 -->
		<option name="LOGOUT_TIME" 			value="0" />			<!-- in minutes, 0 = timer disabled --><!-- 单位为分钟，0 = 禁用计时器 -->
		<option name="LOGOUT_SHUTDOWN"		value="false" />
		<option name="LOGOUT_WHEN_STUCK"	value="true" />
		<option name="CLOSE_WHEN_STUCK"		value="true" />
		<option name="RES_AFTER_DEATH" 		value="true" />
		<option name="MAX_DEATHS" 			value="10" /> 			<!-- Log out after this many deaths --><!-- 死亡达到此次数后登出 -->

		<!-- Party Bot options  --><!-- 组队机器人选项  -->
		<option name="PARTY"				value="false" />
		<option name="PARTY_ICONS"			value="false" /> 		<!-- For party leader to place "I" Icon on the target Mob --><!-- 供队长在目标怪上放置 "I" 标记 -->
		<option name="PARTY_INSTANCE"		value="false" /> 		<!-- For party bot to enable the killing of mobs with high HP  --><!-- 供组队机器人启用击杀高 HP 怪物  -->
		<option name="ICON_FIGHT"			value="false" />		<!-- For party bot to only attack mobs with "I" Icon --><!-- 供组队机器人仅攻击带有 "I" 标记的怪 -->
		<option name="PARTY_FOLLOW_NAME"	value="" /> 			<!-- For party bot name of character to follow --><!-- 组队机器人要跟随的角色名称 -->
		<option name="HEAL_FIGHT"			value="false" />  		<!-- For party bot if you want healer to also fight --><!-- 组队机器人中治疗者是否也参与战斗 -->
		<option name="PARTYLEADER_WAIT"		value="false" /> 		<!-- to make a normal bot wait for party members --><!-- 让普通机器人等待队友 -->
		<option name="MONITOR_WHISPERS"		value="false" /> 		<!-- to monitor whispers instead of party chat --><!-- 监控私语而非队伍聊天 -->

		<!-- pvp --><!-- PVP（玩家对战） -->
		<option name="PVP"		value="" /> <!-- 'true' will auto attack players, 'false' will not fight back, no value will only fight if attacked. --><!-- 'true' 将自动攻击玩家，'false' 不会反击，不设值则仅在被攻击时才反击。 -->

		<!-- For more options and documentation see the RoM Bot Wiki:  --><!-- 更多选项和文档请参见 RoM Bot Wiki：  -->
		<!-- http://www.solarstrike.net/wiki/index.php5?title=RoM_Bot  --><!-- 更多选项和文档请参见 RoM Bot 维基： -->

	</options>

