		<option name="PHIRIUS_MP_LOW"		value="40" />
		<option name="PHIRIUS_HP_LOW"		value="40" />

		<!-- Rest if HP or Mana is below that level --><!-- 当 HP 或 MP 低于此值时休息 -->
		<option name="HP_REST" 				value="15" />
		<option name="MP_REST" 				value="15" />

		<!-- Shopping options, how many of what do you want to keep in your inventory --><!-- 购物选项，你想在背包中保留多少数量的各种物品 -->
		<option name="HEALING_POTION" 		value="99" />
		<option name="MANA_POTION" 			value="99" />			<!-- set to "0" if not required to buy --><!-- 设为 "0" 则不购买 -->
		<option name="ARROW_QUIVER" 		value="0" /> 			<!-- set to "0" if not required to buy --><!-- 设为 "0" 则不购买 -->
		<option name="THROWN_BAG" 			value="2" />			<!-- set to "0" if not required to buy --><!-- 设为 "0" 则不购买 -->
		<option name="POISON" 				value="30" />			<!-- set to "0" if not required to buy --><!-- 设为 "0" 则不购买 -->

		<!-- either false or arrow or thrown --><!-- 可选 false 或 arrow 或 thrown -->
		<option name="RELOAD_AMMUNITION" 	value="false" />		<!-- false|arrow|thrown --><!-- false（不装填）|arrow（箭矢）|thrown（投掷武器） -->

		<!-- Combat options --><!-- 战斗选项 -->
		<option name="COMBAT_TYPE"        	value="" />				<!-- leave empty or choose ranged/melee if not using class default --><!-- 留空使用职业默认，或选择 ranged（远程）/melee（近战） -->
		<option name="COMBAT_RANGED_PULL" 	value="true" /> 		<!-- only important for melees --><!-- 仅对近战职业重要 -->
		<option name="COMBAT_DISTANCE"    	value="200" />			<!-- Distance at which it starts using skills --><!-- 开始使用技能的距离 -->
		<option name="COMBAT_STOP_DISTANCE" value="200" />			<!-- Distance at which it stops moving towards the target --><!-- 停止向目标移动的距离 -->
		<option name="MAX_FIGHT_TIME"     	value="10" />			<!-- Max time without damage before break --><!-- 无伤害输出的最长时间后脱离战斗 -->
		<option name="DOT_PERCENT"        	value="90" />
		<option name="ANTI_KS"            	value="true" />
		<option name="MAX_TARGET_DIST"    	value="225" />
		<option name="PRIORITY_CASTING"		value="false" />		<!-- If you want to cast attack skills by 'priority' or 'sequencially' --><!-- 是否按'优先级'或'顺序'施放攻击技能 -->
		<option name="COUNT_AGGRO_ONLY"		value="false" />		<!-- If you want to count only aggro mobs within range of aoe skills  --><!-- 是否只计算 AOE 技能范围内的仇恨怪  -->
		<option name="AUTO_ELITE_FACTOR"    value="5" />			<!-- (value * your max HP) to designate a mob as "elite" --><!-- （此值 × 你的最大 HP）用于将怪物标记为"精英" -->

		<!-- Attack monsters 3 levels above or 10 below your level --><!-- 攻击高于你 3 级或低于你 10 级的怪物 -->
		<option name="TARGET_LEVELDIF_ABOVE" value="3" />
		<option name="TARGET_LEVELDIF_BELOW" value="10" />

		<!-- Waypoint and movement settings --><!-- 路点和移动设置 -->
		<option name="WAYPOINTS"			value="" />  			<!-- leave empty to show a list --><!-- 留空则显示列表供选择 -->
		<option name="RETURNPATH"			value="" />
		<option name="PATH_TYPE"			value="waypoints" />	<!-- waypoints | wander --><!-- waypoints（沿路点行走）| wander（随机游荡） -->
		<option name="WANDER_RADIUS"		value="500" />
		<option name="WAYPOINT_DEVIATION"	value="0" />
		<option name="QUICK_TURN" 			value="true" />

		<!-- Loot settings --><!-- 拾取设置 -->
		<option name="LOOT"               	value="true" />
