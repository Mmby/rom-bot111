		<option name="SIGILS_IGNORE_LIST"	value="" />				<!-- List of any sigils you wish to ignore, in language of client --><!-- 要忽略的印记列表，使用客户端语言 -->
		<option name="LOOT_JUMPING"			value="false" />		<!-- Jumps while looting to avoid crouching --><!-- 拾取时跳跃以避免蹲下 -->
